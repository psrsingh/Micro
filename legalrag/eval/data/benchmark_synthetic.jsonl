{"id": "q01", "question": "How much notice must a landlord give before seeking eviction under Section 12 of the Sample Tenancy Act?", "legal_issue": "eviction notice period", "act": "Sample Tenancy Act", "section": "12", "gold_authorities": [{"kind": "statute", "act": "Sample Tenancy Act", "section": "12"}, {"kind": "case", "citation": "2004 SYN 21"}], "passages": [{"authority": "Sample Tenancy Act|12", "text": "not less than thirty days' notice in writing"}, {"authority": "2004 SYN 21", "text": "Eviction proceedings instituted without thirty days' written notice under Section 12 are not maintainable."}], "expected_conclusion": "Thirty days' written notice.", "must_include": [["thirty days", "30 days"], ["writing", "written"]], "claim_labels": [{"text": "A landlord must give the tenant at least thirty days' written notice before instituting eviction proceedings.", "label": "supported"}, {"text": "A landlord must give the tenant at least sixty days' notice before instituting eviction proceedings.", "label": "unsupported"}], "tags": ["statute", "single_hop"]}
{"id": "q02", "question": "Is an oral notice enough before a landlord files for eviction of a tenant?", "legal_issue": "form of eviction notice", "act": "Sample Tenancy Act", "section": "12", "gold_authorities": [{"kind": "case", "citation": "2004 SYN 21"}, {"kind": "statute", "act": "Sample Tenancy Act", "section": "12"}], "passages": [{"authority": "2004 SYN 21", "text": "oral notice is not sufficient"}, {"authority": "Sample Tenancy Act|12", "text": "not less than thirty days' notice in writing"}], "expected_conclusion": "No: the notice must be in writing.", "must_include": [["written", "writing"], ["thirty days", "30 days"]], "tags": ["case_law"]}
{"id": "q03", "question": "Does an emailed notice satisfy the requirement of written notice for eviction?", "legal_issue": "email as written notice", "act": "Sample Tenancy Act", "section": "12", "gold_authorities": [{"kind": "case", "citation": "2019 SYN 27"}, {"kind": "statute", "act": "Sample Tenancy Act", "section": "12"}], "passages": [{"authority": "2019 SYN 27", "text": "Email notice is written notice under Section 12 when receipt is proved."}, {"authority": "Sample Tenancy Act|12", "text": "not less than thirty days' notice in writing"}], "expected_conclusion": "Yes, if receipt is proved.", "must_include": [["email"], ["receipt", "received", "delivery", "reached"], ["written notice", "satisfies", "sufficient", "valid"]], "claim_labels": [{"text": "An email notice counts as written notice under Section 12 when receipt is proved.", "label": "supported"}, {"text": "Only paper notice counts as written notice under Section 12.", "label": "contradicted"}], "tags": ["case_law"]}
{"id": "q04", "question": "Can a tenant sublet part of the premises without the landlord's written consent?", "legal_issue": "subletting", "act": "Sample Tenancy Act", "section": "15", "gold_authorities": [{"kind": "statute", "act": "Sample Tenancy Act", "section": "15"}, {"kind": "case", "citation": "2008 SYN 5"}], "passages": [{"authority": "Sample Tenancy Act|15", "text": "A tenant shall not sublet the premises or any part of them without the prior written consent of the landlord."}, {"authority": "2008 SYN 5", "text": "Subletting without written consent entitles the landlord to eviction under Section 15."}], "expected_conclusion": "No; it is a ground for eviction.", "must_include": [["written consent", "consent in writing", "prior written"]], "tags": ["statute", "case_law"]}
{"id": "q05", "question": "Does a landlord's acceptance of rent amount to consent to subletting?", "legal_issue": "implied consent to subletting", "act": "Sample Tenancy Act", "section": "15", "gold_authorities": [{"kind": "case", "citation": "2008 SYN 5"}], "passages": [{"authority": "2008 SYN 5", "text": "Acceptance of rent does not amount to consent."}], "expected_conclusion": "No.", "must_include": [["does not", "not amount", "cannot", "not imply", "not consent"], ["consent"]], "claim_labels": [{"text": "Acceptance of rent does not amount to consent to subletting.", "label": "supported"}, {"text": "Acceptance of rent for two years amounts to implied consent to subletting.", "label": "contradicted"}], "tags": ["case_law"]}
{"id": "q06", "question": "What is the maximum security deposit a landlord may currently take from a tenant?", "legal_issue": "security deposit cap", "act": "Sample Tenancy Act", "section": "7", "gold_authorities": [{"kind": "statute", "act": "Sample Tenancy Act", "section": "7"}], "passages": [{"authority": "Sample Tenancy Act|7", "text": "A landlord shall not demand or accept a security deposit exceeding three months' rent."}], "current_status": "superseded_text_trap", "expected_conclusion": "Three months' rent (raised from two by the 2012 amendment).", "must_include": [["three months"]], "must_not_include": [{"phrase": "two months", "category": "outdated_authority", "unless_any": ["amend", "2012", "earlier", "previous", "before", "raised", "originally", "formerly", "used to"]}], "claim_labels": [{"text": "A landlord shall not demand or accept a security deposit exceeding three months' rent.", "label": "supported"}, {"text": "A landlord shall not demand or accept a security deposit exceeding two months' rent.", "label": "contradicted"}], "tags": ["statute", "temporal"]}
{"id": "q07", "question": "What was the cap on a security deposit for a tenancy created in 2010?", "legal_issue": "prospective effect of the 2012 amendment", "act": "Sample Tenancy Act", "section": "7", "gold_authorities": [{"kind": "case", "citation": "2013 SYN 18"}, {"kind": "statute", "act": "Sample Tenancy Act", "section": "7"}], "passages": [{"authority": "2013 SYN 18", "text": "For tenancies created before 1 July 2012 the two month cap continues to apply."}, {"authority": "Sample Tenancy Act|7", "text": "A landlord shall not demand or accept a security deposit exceeding two months' rent."}], "current_status": "superseded_text_trap", "expected_conclusion": "Two months' rent: the amendment is prospective.", "must_include": [["two month", "2 month"]], "must_not_include": [{"phrase": "three months", "category": "outdated_authority", "unless_any": ["after", "2012", "amend", "later", "on or after"]}], "tags": ["temporal", "case_law"]}
{"id": "q08", "question": "In Kavita Rao v. Greenfield Housing Society, how was the excess security deposit to be dealt with?", "legal_issue": "refund of excess deposit", "act": "Sample Tenancy Act", "section": "7", "gold_authorities": [{"kind": "case", "citation": "2011 SYN 33"}], "passages": [{"authority": "2011 SYN 33", "text": "The excess over two months' rent must be refunded with interest, and the balance refunded within thirty days of vacating."}], "expected_conclusion": "Refunded with interest; balance within thirty days.", "must_include": [["refund"], ["interest"]], "tags": ["case_law", "named_case"]}
{"id": "q09", "question": "Is a manufacturer bound to repair or replace a defective product during the warranty period?", "legal_issue": "warranty duty", "act": "Sample Consumer Protection Act", "section": "3", "gold_authorities": [{"kind": "statute", "act": "Sample Consumer Protection Act", "section": "3"}, {"kind": "case", "citation": "2015 SYN 9"}], "passages": [{"authority": "Sample Consumer Protection Act|3", "text": "Goods sold with a warranty shall be repaired or replaced by the manufacturer without charge if they prove defective during the warranty period."}, {"authority": "2015 SYN 9", "text": "Section 3 of the Sample Consumer Protection Act, 2010 implies a duty to repair or replace goods that are defective during the warranty period."}], "expected_conclusion": "Yes, without charge.", "must_include": [["repair"], ["replace"]], "tags": ["statute", "case_law"]}
{"id": "q10", "question": "Can a warranty card exclude the manufacturer's duty to replace a defective product?", "legal_issue": "contracting out of warranty duty", "act": "Sample Consumer Protection Act", "section": "3", "gold_authorities": [{"kind": "case", "citation": "2015 SYN 9"}], "passages": [{"authority": "2015 SYN 9", "text": "Terms excluding replacement during the warranty period are unenforceable."}], "expected_conclusion": "No: such terms are unenforceable.", "must_include": [["unenforceable", "cannot", "not enforceable", "not valid", "invalid"]], "tags": ["case_law"]}
{"id": "q11", "question": "Who must prove that a defect was caused by misuse of the product?", "legal_issue": "burden of proving misuse", "act": "Sample Consumer Protection Act", "section": "3", "gold_authorities": [{"kind": "case", "citation": "2020 SYN 3"}], "passages": [{"authority": "2020 SYN 3", "text": "Misuse is an exception to that duty and the party relying on an exception must prove it."}], "expected_conclusion": "The manufacturer.", "must_include": [["manufacturer"], ["prove", "burden"]], "tags": ["case_law"]}
{"id": "q12", "question": "Within what period must a consumer complaint be filed?", "legal_issue": "limitation for consumer complaints", "act": "Sample Consumer Protection Act", "section": "9", "gold_authorities": [{"kind": "statute", "act": "Sample Consumer Protection Act", "section": "9"}, {"kind": "case", "citation": "2017 SYN 41"}], "passages": [{"authority": "Sample Consumer Protection Act|9", "text": "A complaint shall be filed within two years from the date on which the cause of action arises."}, {"authority": "2017 SYN 41", "text": "a complaint must be filed within two years of the cause of action"}], "expected_conclusion": "Two years from the cause of action.", "must_include": [["two years", "2 years"]], "tags": ["statute", "case_law"]}
{"id": "q13", "question": "Can a delay in filing a consumer complaint be excused?", "legal_issue": "condonation of delay", "act": "Sample Consumer Protection Act", "section": "9", "gold_authorities": [{"kind": "statute", "act": "Sample Consumer Protection Act", "section": "9"}, {"kind": "case", "citation": "2017 SYN 41"}], "passages": [{"authority": "Sample Consumer Protection Act|9", "text": "A complaint filed after that period may be entertained if the complainant satisfies the forum that there was sufficient cause for the delay."}, {"authority": "2017 SYN 41", "text": "delay may be condoned on sufficient cause"}], "expected_conclusion": "Yes, on sufficient cause for the whole delay.", "must_include": [["sufficient cause"]], "tags": ["statute", "case_law"]}
{"id": "q14", "question": "My landlord told me orally that he wants the shop back and filed for eviction ten days later. Can the court allow the eviction?", "legal_issue": "eviction without written notice (fact pattern)", "act": "Sample Tenancy Act", "section": "12", "gold_authorities": [{"kind": "case", "citation": "2004 SYN 21"}, {"kind": "statute", "act": "Sample Tenancy Act", "section": "12"}], "passages": [{"authority": "2004 SYN 21", "text": "Eviction proceedings instituted without thirty days' written notice under Section 12 are not maintainable."}, {"authority": "Sample Tenancy Act|12", "text": "not less than thirty days' notice in writing"}], "expected_conclusion": "No: the proceedings are not maintainable without thirty days' written notice.", "must_include": [["written", "writing"], ["thirty days", "30 days", "not maintainable", "not sufficient"]], "tags": ["fact_pattern", "case_law"]}
